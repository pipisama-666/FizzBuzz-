import tkinter as tk
import random

class BingoSystem:
    def __init__(self, root):
        self.root = root
        self.root.title("ビンゴの司会システム")
        self.used_numbers = []
        self.remaining_numbers = list(range(1, 76))

        # ラベル：選ばれた番号を表示
        self.number_label = tk.Label(self.root, text="番号がここに表示されます", font=("Helvetica", 48), width=20)
        self.number_label.pack(pady=20)

        # ボタン：次の番号を選ぶ
        self.select_button = tk.Button(self.root, text="次の番号を選ぶ", font=("Helvetica", 24), command=self.select_number)
        self.select_button.pack(pady=10)

        # ラベル：履歴を表示
        self.history_label = tk.Label(self.root, text="履歴:", font=("Helvetica", 16), anchor="w", justify="left")
        self.history_label.pack(pady=20, fill="both")

    def select_number(self):
        if self.remaining_numbers:
            selected_number = random.choice(self.remaining_numbers)
            self.remaining_numbers.remove(selected_number)
            self.used_numbers.append(selected_number)

            # 選ばれた番号を表示
            self.number_label.config(text=str(selected_number))

            # 履歴を更新
            history_text = "履歴: " + ", ".join(map(str, self.used_numbers))
            self.history_label.config(text=history_text)
        else:
            self.number_label.config(text="すべての番号が選ばれました")
            self.select_button.config(state="disabled")
if __name__ == "__main__":
    root = tk.Tk()
    app = BingoSystem(root)
    root.mainloop()
